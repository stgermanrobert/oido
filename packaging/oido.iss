Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.alac\shell\Oido"; ValueType: string; ValueName: ""; ValueData: "{cm:CtxLabel}"; Tasks: contextmenu; Flags: uninsdeletekey
