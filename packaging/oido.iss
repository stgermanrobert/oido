Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.alac\shell\Oido\command"; ValueType: string; ValueName: ""; ValueData: """{app}\Oido.exe"" ""%1"""; Tasks: contextmenu

[Run]
Filename: "{app}\{#MyAppExe}"; Description: "{cm:LaunchProgram,{#MyAppName}}"; Flags: nowait postinstall skipifsilent
