Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.ogg\shell\Oido"; ValueType: string; ValueName: "Icon"; ValueData: "{app}\Oido.exe"; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.ogg\shell\Oido\command"; ValueType: string; ValueName: ""; ValueData: """{app}\Oido.exe"" ""%1"""; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.opus\shell\Oido"; ValueType: string; ValueName: ""; ValueData: "{cm:CtxLabel}"; Tasks: contextmenu; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.opus\shell\Oido"; ValueType: string; ValueName: "Icon"; ValueData: "{app}\Oido.exe"; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.opus\shell\Oido\command"; ValueType: string; ValueName: ""; ValueData: """{app}\Oido.exe"" ""%1"""; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.aiff\shell\Oido"; ValueType: string; ValueName: ""; ValueData: "{cm:CtxLabel}"; Tasks: contextmenu; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.aiff\shell\Oido"; ValueType: string; ValueName: "Icon"; ValueData: "{app}\Oido.exe"; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.aiff\shell\Oido\command"; ValueType: string; ValueName: ""; ValueData: """{app}\Oido.exe"" ""%1"""; Tasks: contextmenu
