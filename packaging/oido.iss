Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.wma\shell\Oido"; ValueType: string; ValueName: ""; ValueData: "{cm:CtxLabel}"; Tasks: contextmenu; Flags: uninsdeletekey
