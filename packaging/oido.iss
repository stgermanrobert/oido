; Oído installer (Inno Setup 6). Build with:  ISCC /DMyVersion=1.0.0 oido.iss
; Generated by gen_packaging.py: edit the generator, not this file.
#ifndef MyVersion
  #define MyVersion "0.0.0"
#endif
#define MyAppName "Oído"
#define MyAppExe "Oido.exe"

[Setup]
AppId={{04749E98-05E6-5081-9108-91CE7EE93C88}
AppName={#MyAppName}
AppVersion={#MyVersion}
AppVerName={#MyAppName} {#MyVersion}
AppPublisher=Germán Robert
AppPublisherURL=https://github.com/stgermanrobert/oido
AppSupportURL=https://github.com/stgermanrobert/oido/issues
AppUpdatesURL=https://github.com/stgermanrobert/oido/releases
VersionInfoVersion={#MyVersion}
VersionInfoDescription=Oído — Audio quality analyzer
DefaultDirName={autopf}\Oido
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir=..\out
OutputBaseFilename=Oido-Setup-{#MyVersion}
SetupIconFile=oido.ico
UninstallDisplayIcon={app}\{#MyAppExe}
UninstallDisplayName={#MyAppName}
WizardStyle=modern
WizardImageFile=installer_side.bmp
WizardSmallImageFile=installer_small.bmp
LicenseFile=..\LICENSE
Compression=lzma2/max
SolidCompression=yes
LZMAUseSeparateProcess=yes
CloseApplications=yes
ShowLanguageDialog=auto

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"

[CustomMessages]
english.CtxLabel=Analyze with Oído
english.CtxTask=Add "Analyze with Oído" to the context menu of audio files
english.CtxGroup=Windows integration:
spanish.CtxLabel=Analizar con Oído
spanish.CtxTask=Añadir "Analizar con Oído" al menú contextual de los archivos de audio
spanish.CtxGroup=Integración con Windows:
russian.CtxLabel=Анализировать в Oído
russian.CtxTask=Добавить «Анализировать в Oído» в контекстное меню аудиофайлов
russian.CtxGroup=Интеграция с Windows:

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
Name: "contextmenu"; Description: "{cm:CtxTask}"; GroupDescription: "{cm:CtxGroup}"

[Files]
Source: "..\dist\Oido\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExe}"; AppUserModelID: "GermanRobert.Oido"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExe}"; AppUserModelID: "GermanRobert.Oido"; Tasks: desktopicon

[Registry]
Root: HKCU; Subkey: "Software\GermanRobert\Oido"; ValueType: string; ValueName: "InstallPath"; ValueData: "{app}"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\GermanRobert\Oido"; ValueType: string; ValueName: "Version"; ValueData: "{#MyVersion}"
Root: HKCU; Subkey: "Software\GermanRobert\Oído"; ValueType: string; ValueName: "lang"; ValueData: "en"; Languages: english; Flags: createvalueifdoesntexist
Root: HKCU; Subkey: "Software\GermanRobert\Oído"; ValueType: string; ValueName: "lang"; ValueData: "es"; Languages: spanish; Flags: createvalueifdoesntexist
Root: HKCU; Subkey: "Software\GermanRobert\Oído"; ValueType: string; ValueName: "lang"; ValueData: "ru"; Languages: russian; Flags: createvalueifdoesntexist
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.mp3\shell\Oido"; ValueType: string; ValueName: ""; ValueData: "{cm:CtxLabel}"; Tasks: contextmenu; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.mp3\shell\Oido"; ValueType: string; ValueName: "Icon"; ValueData: "{app}\Oido.exe"; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.mp3\shell\Oido\command"; ValueType: string; ValueName: ""; ValueData: """{app}\Oido.exe"" ""%1"""; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.flac\shell\Oido"; ValueType: string; ValueName: ""; ValueData: "{cm:CtxLabel}"; Tasks: contextmenu; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.flac\shell\Oido"; ValueType: string; ValueName: "Icon"; ValueData: "{app}\Oido.exe"; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.flac\shell\Oido\command"; ValueType: string; ValueName: ""; ValueData: """{app}\Oido.exe"" ""%1"""; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.wav\shell\Oido"; ValueType: string; ValueName: ""; ValueData: "{cm:CtxLabel}"; Tasks: contextmenu; Flags: uninsdeletekey
