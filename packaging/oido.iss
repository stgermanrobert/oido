Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.m4a\shell\Oido"; ValueType: string; ValueName: "Icon"; ValueData: "{app}\Oido.exe"; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.m4a\shell\Oido\command"; ValueType: string; ValueName: ""; ValueData: """{app}\Oido.exe"" ""%1"""; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.aac\shell\Oido"; ValueType: string; ValueName: ""; ValueData: "{cm:CtxLabel}"; Tasks: contextmenu; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\SystemFileAssociations\.aac\shell\Oido"; ValueType: string; ValueName: "Icon"; ValueData: "{app}\Oido.exe"; Tasks: contextmenu
